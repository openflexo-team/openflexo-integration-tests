/**
 * Mapping - federates two heterogeneous EMF city models (city1 and city2) into a single set of
 * concepts, each holding one foot in each model. This is the heart of the CityMapping demo.
 *
 * Migrated from the deprecated .fml.xml serialization to textual FML. What was recovered or
 * repaired, and why:
 *   - every MatchFlexoConceptInstance had lost its target concept, its matching criteria and its
 *     creation scheme on load; they were recovered from the legacy XML;
 *   - Appartment and Mansion lost their "extends House" on load; restored;
 *   - Resident was declared abstract yet had a creation scheme and was instantiated by the
 *     synchronization; since it has no sub-concept, the abstract flag was a mistake and is dropped;
 *   - creation-scheme parameters typed as the raw IFlexoOntologyIndividual are now typed with the
 *     matching EMF individual type, which is what the roles they feed actually expect.
 *
 * One legacy defect is KEPT as-is because it is not a serialization problem: "house1.type.name"
 * does not resolve. house1.type is a city1 HouseType (an EMF Enumerator with literals Mansion /
 * Appartment) loaded through the EMF adapter's own class loader, and Connie cannot introspect it
 * from here. It was already invalid in the .fml.xml; fixing it belongs to the EMF class-loading
 * path, not to this migration.
 */

use org.openflexo.technologyadapter.emf.EMFModelSlot as EMF;

import org.openflexo.technologyadapter.emf.model.EMFModel;
import org.openflexo.technologyadapter.emf.model.EMFObjectIndividual;
import org.openflexo.technologyadapter.emf.metamodel.EMFMetaModel;
import org.openflexo.technologyadapter.emf.metamodel.EMFClassClass;
import java.lang.String;
import java.util.List;

import EMFMetaModel CITY1 from ["http://www.thalesgroup.com/openflexo/emf/model/city1"];
import EMFMetaModel CITY2 from ["http://www.thalesgroup.com/openflexo/emf/model/city2"];

import EMFClassClass CITY1_CITY from [CITY1:"City"];
import EMFClassClass CITY1_HOUSE from [CITY1:"House"];
import EMFClassClass CITY1_RESIDENT from [CITY1:"Resident"];
import EMFClassClass CITY2_CITY from [CITY2:"City"];
import EMFClassClass CITY2_HOUSE from [CITY2:"House"];
import EMFClassClass CITY2_APPARTMENT from [CITY2:"Appartment"];
import EMFClassClass CITY2_MANSION from [CITY2:"Mansion"];
import EMFClassClass CITY2_MAYOR from [CITY2:"Mayor"];

typedef EMFObjectIndividualType(eClass=CITY1_CITY) as City1City;
typedef EMFObjectIndividualType(eClass=CITY1_HOUSE) as City1House;
typedef EMFObjectIndividualType(eClass=CITY1_RESIDENT) as City1Resident;
typedef EMFObjectIndividualType(eClass=CITY2_CITY) as City2City;
typedef EMFObjectIndividualType(eClass=CITY2_HOUSE) as City2House;
typedef EMFObjectIndividualType(eClass=CITY2_APPARTMENT) as City2Appartment;
typedef EMFObjectIndividualType(eClass=CITY2_MANSION) as City2Mansion;
typedef EMFObjectIndividualType(eClass=CITY2_MAYOR) as City2Mayor;

@URI("http://www.thalesgroup.com/openflexo/emf/CityMapping/Mapping.fml")
@Version("0.1")
public model Mapping {

	EMFModel model1 with EMFModelSlot(metaModel=CITY1, isRequired=true);
	EMFModel model2 with EMFModelSlot(metaModel=CITY2, isRequired=true);

	// Walks both models and federates what belongs together: cities matched on name, houses on
	// their info/label, residents on the owner name. Whatever exists on one side only is federated
	// with a null counterpart, which is precisely what generateModelXFromModelY() later fills in.
	synchronization() {
		for (City1City city1 : select City1City from model1) {
			List<City2City> matchingCitiesInModel2 = select City2City from model2 where (selected.name.toUpperCase == city1.name.toUpperCase);
			if (matchingCitiesInModel2.size == 0) {
				match City from this where (cityInModel1=city1, cityInModel2=null)
					unmatched: new City::createFromEMF(city1, null);
			}
			if (matchingCitiesInModel2.size == 1) {
				match City from this where (cityInModel1=city1, cityInModel2=matchingCitiesInModel2.get(0))
					unmatched: new City::createFromEMF(city1, matchingCitiesInModel2.get(0));
			}
			List<City> tempList = select City from this where (selected.cityInModel1 == city1);
			City currentCity = tempList.get(0);
			for (City1House house1 : city1.houses) {
				if (house1.type.name == "Appartment") {
					List<City2Appartment> matchingAppartmentsInModel2 = select City2Appartment from model2 where (selected.label == house1.info);
					if (matchingAppartmentsInModel2.size == 0) {
						match Appartment from this where (houseInModel1=house1, appartmentInModel2=null, city=currentCity)
							unmatched: new Appartment::creation(house1, null, currentCity);
					}
					if (matchingAppartmentsInModel2.size == 1) {
						match Appartment from this where (houseInModel1=house1, appartmentInModel2=matchingAppartmentsInModel2.get(0), city=currentCity)
							unmatched: new Appartment::creation(house1, matchingAppartmentsInModel2.get(0), currentCity);
					}
				}
				if (house1.type.name == "Mansion") {
					List<City2Mansion> matchingMansionsInModel2 = select City2Mansion from model2 where (selected.number.toString == house1.info);
					if (matchingMansionsInModel2.size == 0) {
						match Mansion from this where (houseInModel1=house1, mansionInModel2=null, city=currentCity)
							unmatched: new Mansion::creation(house1, null, currentCity);
					}
					if (matchingMansionsInModel2.size == 1) {
						match Mansion from this where (houseInModel1=house1, mansionInModel2=matchingMansionsInModel2.get(0), city=currentCity)
							unmatched: new Mansion::creation(house1, matchingMansionsInModel2.get(0), currentCity);
					}
				}
			}
		}
		for (City1Resident residentInModel1 : select City1Resident from model1) {
			List<City2House> matchingHousesWithSameResident = select City2House from model2 where (selected.owner.toUpperCase == residentInModel1.name.toUpperCase);
			if (matchingHousesWithSameResident.size == 0) {
				match Resident from this where (residentInModel1=residentInModel1, houseInModel2=null)
					unmatched: new Resident::creation(residentInModel1, null);
			}
			if (matchingHousesWithSameResident.size >= 1) {
				match Resident from this where (residentInModel1=residentInModel1, houseInModel2=matchingHousesWithSameResident.get(0))
					unmatched: new Resident::creation(residentInModel1, matchingHousesWithSameResident.get(0));
			}
		}
		// Cities that exist only in model2 are federated too, with an empty model1 side.
		for (City2City city2 : select City2City from model2) {
			List<City1City> matchingCitiesInModel1 = select City1City from model1 where (selected.name == city2.name);
			if (matchingCitiesInModel1.size == 0) {
				match City from this where (cityInModel1=null, cityInModel2=city2)
					unmatched: new City::createFromEMF(null, city2);
			}
		}
	}

	void synchronizeModel2FromModel1() {
		List<City> nonExistantCitiesInModel2 = select City from this where (selected.cityInModel2 == null);
		for (City nonExistantCity : nonExistantCitiesInModel2) {
			nonExistantCity.generateModel2FromModel1();
		}
	}

	void synchronizeModel1FromModel2() {
		List<City> nonExistingCitiesInModel1 = select City from this where (selected.cityInModel1 == null);
		for (City nonExistingCity : nonExistingCitiesInModel1) {
			nonExistingCity.generateModel1FromModel2();
		}
	}

	create::defaultCreationScheme(required Resource<EMFModel> city1, required Resource<EMFModel> city2) {
		model1 = (EMFModel) parameters.city1.getResourceData();
		model2 = (EMFModel) parameters.city2.getResourceData();
	}

	@Renderer((instance.cityInModel1 != null ? (instance.cityInModel2 != null ? instance.cityInModel1.name + " [sync]" : instance.cityInModel1.name + " [model1]") : instance.cityInModel2.name + " [model2]"))
	public concept City {

		City1City cityInModel1 with EMFObjectRole(container=model1, type=CITY1_CITY);
		City2City cityInModel2 with EMFObjectRole(container=model2, type=CITY2_CITY);

		create::createFromEMF(City1City cityInModel1, City2City cityInModel2) {
			cityInModel1 = parameters.cityInModel1;
			cityInModel2 = parameters.cityInModel2;
		}

		@UI(
			@TextField(value="cityName")
		)
		create::createANewOne(String cityName) {
			cityInModel1 = EMF::AddEMFObject(ontologyClass=CITY1_CITY) in model1;
			cityInModel2 = EMF::AddEMFObject(ontologyClass=CITY2_CITY) in model2;
		}

		void generateModel2FromModel1() {
			cityInModel2 = EMF::AddEMFObject(ontologyClass=CITY2_CITY) in model2;
		}

		void generateModel1FromModel2() {
			cityInModel1 = EMF::AddEMFObject(ontologyClass=CITY1_CITY) in model1;
		}

		delete::deletion() {
			delete cityInModel1;
			delete cityInModel2;
		}
	}

	public abstract concept House {
	}

	public concept Appartment extends House {

		City1House houseInModel1 with EMFObjectRole(container=model1, type=CITY1_HOUSE);
		City2Appartment appartmentInModel2 with EMFObjectRole(container=model2, type=CITY2_APPARTMENT);
		City city;

		create::creation(City1House houseInModel1, City2Appartment appartmentInModel2, City cityParameter) {
			houseInModel1 = parameters.houseInModel1;
			appartmentInModel2 = parameters.appartmentInModel2;
			city = parameters.cityParameter;
		}

		delete::deletion() {
			delete houseInModel1;
			delete appartmentInModel2;
		}
	}

	public concept Mansion extends House {

		City1House houseInModel1 with EMFObjectRole(container=model1, type=CITY1_HOUSE);
		City2Mansion mansionInModel2 with EMFObjectRole(container=model2, type=CITY2_MANSION);
		City city;

		create::creation(City1House houseInModel1, City2Mansion mansionInModel2, City cityParameter) {
			houseInModel1 = parameters.houseInModel1;
			mansionInModel2 = parameters.mansionInModel2;
			city = parameters.cityParameter;
		}

		delete::deletion() {
			delete houseInModel1;
			delete mansionInModel2;
		}
	}

	public concept Resident {

		City1Resident residentInModel1 with EMFObjectRole(container=model1, type=CITY1_RESIDENT);
		City2House houseInModel2 with EMFObjectRole(container=model2, type=CITY2_HOUSE);

		create::creation(City1Resident residentInModel1, City2House houseInModel2) {
			residentInModel1 = parameters.residentInModel1;
			houseInModel2 = parameters.houseInModel2;
		}
	}

	// NB: kept as the legacy declared it - a city2 Mayor individual held in model1.
	public concept Mayor {
		City2Mayor mayor with EMFObjectRole(container=model1, type=CITY2_MAYOR);
	}
}
