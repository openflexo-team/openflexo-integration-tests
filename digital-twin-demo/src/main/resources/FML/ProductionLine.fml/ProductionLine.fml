/**
 * DigitalTwinDemo - VirtualModel "ProductionLine".
 *
 * Federates the CAEX/AutomationML topology (production-line.xml, typed against production-line.xsd) with the
 * maintenance workbook (maintenance.xlsx), and derives a maintenance-priority hierarchy that no
 * artifact holds alone. Three readings of the same line disagree, and that disagreement is the
 * whole point:
 *   1. the workbook alone, raw vibration      -> ETI04A (6.5 mm/s)     : the WRONG answer
 *   2. plus the XML thresholds                -> CONV03 and ETI04A both at ~93% : a tie
 *   3. plus the topology                      -> ETI04A is doubled by ETI04B, CONV03 is the
 *                                                bottleneck nothing bypasses : CONV03.
 *
 * How the model is built, and why it reads the way it does:
 *
 *   STRUCTURE IS MATERIALIZED. Equipment is not a computed view: it is an instantiated concept
 *   holding four roles that point at the actual artifact elements - the InternalElement of the XML
 *   (xmlElement), its row in the Assets sheet (assetRecord), its readings (readings) and its maintenance
 *   maintenance (interventions). synchronize() fills them, using the FML match mechanism, so the
 *   structure can be inspected in projection rather than re-derived at every access.
 *
 *   VALUES ARE DERIVED. Everything on top of those roles - thresholds, ratios, drift, criticity -
 *   is an expression (values) or a get() property. Nothing is a field set from the outside, and
 *   criticity in particular is NEVER stored in an artifact: it is derived from the topology.
 *   (The write-back into Assets column H is a projection sink, not a source of truth.)
 *
 *   RE-SYNCHRONIZATION, NOT RECOMPUTATION. After a live manipulation, synchronize() is run again:
 *   it re-attaches the structure (a new reading enters the readings role, a new link becomes a
 *   MaterialLink) and every derived value follows on its own. The match makes it idempotent.
 */

use org.openflexo.technologyadapter.xml.XMLModelSlot as XML;
use org.openflexo.technologyadapter.excel.FMLExcelModelSlot as XLS;
use org.openflexo.foundation.fml.rt.FMLRTModelSlot as FMLRT;

import org.openflexo.technologyadapter.xml.model.typed.XMLModel;
import org.openflexo.technologyadapter.xml.model.typed.XMLIndividual;
import org.openflexo.technologyadapter.xml.metamodel.XSDMetaModel;
import org.openflexo.technologyadapter.xml.metamodel.XMLComplexType;
import org.openflexo.technologyadapter.excel.model.ExcelWorkbook;
import org.openflexo.technologyadapter.excel.fml.reflect.rt.XLSVirtualModelInstance;
import java.lang.Double;
import java.util.List;
import java.util.ArrayList;
import java.lang.String;

// The annotated VirtualModel that types the maintenance workbook (Reading / AssetRecord / Intervention).
import ["http://openflexo.org/digital-twin-demo/FML/MaintenanceRecords.fml"];

import XSDMetaModel CAEX from ["http://www.dke.de/CAEX"];
import XMLComplexType INTERNAL_ELEMENT from [CAEX:"InternalElementType"];
import XMLComplexType ATTRIBUTE from [CAEX:"AttributeType"];
import XMLComplexType INTERNAL_LINK from [CAEX:"InternalLinkType"];

typedef XMLIndividualType(xsdType=INTERNAL_ELEMENT) as InternalElement;
typedef XMLIndividualType(xsdType=ATTRIBUTE) as CaexAttribute;
typedef XMLIndividualType(xsdType=INTERNAL_LINK) as InternalLink;

@URI("http://openflexo.org/digital-twin-demo/FML/ProductionLine.fml")
public model ProductionLine {

	XMLModel ligneXml with XMLModelSlot(metaModel=CAEX);
	// Reflected against the "MaintenanceRecords" contract VM: maintenance.flexoConceptInstances are
	// typed Reading / AssetRecord / Intervention instances, each backed by a workbook row.
	MaintenanceRecords maintenance with FMLExcelModelSlot();

	create(Resource<XMLModel> xmlResource, Resource<ExcelWorkbook> xlsxResource) {
		connect ligneXml using parameters.xmlResource;
		connect maintenance using parameters.xlsxResource;
		this.synchronize();
	}

	// =========================================================================
	// Structural synchronization - instantiates the concepts and attaches them to the artifact
	// elements. Re-runnable: 'match' reuses the existing instances instead of duplicating them,
	// and each multiple role is refilled with a membership-guarded add (match de-duplicates the
	// instances it matches, never the contents of their roles).
	// =========================================================================
	public synchronize() {
		this.synchronizeEquipments();
		this.synchronizeMaterialLinks();
	}

	public synchronizeEquipments() {
		MatchingSet<Equipment> ms = begin match Equipment from this;
		for (InternalElement e : select InternalElement from ligneXml) {
			Equipment eq = match Equipment in ms from this where (xmlElement=e) unmatched: new Equipment(e);
			// Join on code (EQ-CONV-03 <-> CONV03): this is where the two artifacts meet.
			// assetRecord stays empty for EQ-ETI-04B, absent from the inventory (planted, not repaired).
			AssetRecord f = this.getAssetRecord(eq.code);
			if (f != null) {
				eq.assetRecord = f;
			}
			// A multiple role is filled one element at a time; the membership guard is what makes
			// re-running this behaviour idempotent (a bare add would pile the readings up again).
			for (Reading r : select Reading from maintenance where (selected.code == eq.code)) {
				if (!eq.readings.contains(r)) {
					eq.readings.add(r);
				}
			}
			for (Intervention i : select Intervention from maintenance where (selected.code == eq.code)) {
				if (!eq.interventions.contains(i)) {
					eq.interventions.add(i);
				}
			}
		}
		end match Equipment in ms unmatched: delete();
	}

	// One MaterialLink per InternalLink, its two ends resolved to the Equipment instances they name.
	// Run after synchronizeEquipments(), since it links to those instances.
	public synchronizeMaterialLinks() {
		MatchingSet<MaterialLink> ms = begin match MaterialLink from this;
		for (InternalLink l : select InternalLink from ligneXml) {
			MaterialLink li = match MaterialLink in ms from this where (xmlLink=l) unmatched: new MaterialLink(l);
			Equipment src = this.getEquipmentByCode(li.sourceCode);
			if (src != null) {
				li.source = src;
			}
			Equipment dst = this.getEquipmentByCode(li.targetCode);
			if (dst != null) {
				li.target = dst;
			}
		}
		end match MaterialLink in ms unmatched: delete();
	}

	public List<MaterialLink> getMaterialLinks() {
		return select MaterialLink from this;
	}

	// --- XML side ---
	public List<InternalElement> getInternalElements() {
		return select InternalElement from ligneXml;
	}

	// --- Excel side (typed through the MaintenanceRecords reflected VMI) ---
	public AssetRecord getAssetRecord(String code) {
		return select unique AssetRecord from maintenance where (selected.code == parameters.code);
	}

	public List<Intervention> getInterventions() {
		return select Intervention from maintenance;
	}

	// Join rule EQ-DEP-01 <-> DEP01 : drop the "EQ-" prefix and all dashes (spec section 2).
	// Behaviour parameters are read via "parameters.".
	public String codeFromXmlId(String xmlId) {
		String withoutPrefix = parameters.xmlId.replace("EQ-","");
		return withoutPrefix.replace("-","");
	}

	// --- Federation ---
	public List<Equipment> getEquipments() {
		return select Equipment from this;
	}

	public Equipment getEquipmentByCode(String code) {
		return select unique Equipment from this where (selected.code == parameters.code);
	}

	// =========================================================================
	// Topology (XML only). A link "EQ-A:OUT" -> "EQ-B:IN" is an edge A -> B. Interfaces are
	// shared (EQ-CONV-03:OUT appears in both L3 and L4), so navigation goes through the links.
	// =========================================================================

	// Equipment code owning an interface id, e.g. "EQ-CONV-03:OUT" -> "CONV03".
	public String codeFromInterface(String iface) {
		int idx = parameters.iface.indexOf(":");
		String xmlId = parameters.iface.substring(0,idx);
		return this.codeFromXmlId(xmlId);
	}

	// Entry = the only equipment no link points to; exit = the only one no link leaves.
	public Equipment getEntry() {
		return select unique Equipment from this where (selected.isEntry);
	}

	public Equipment getExit() {
		return select unique Equipment from this where (selected.isExit);
	}

	// Which equipments the material can still reach from the entry when one of them is removed.
	// Level-by-level walk over the MaterialLink graph.
	public List<Equipment> reachableFromEntryWithout(Equipment avoided) {
		List<Equipment> seen = new ArrayList();
		List<Equipment> current = new ArrayList();
		Equipment entry = this.getEntry();
		if (entry != parameters.avoided) {
			seen.add(entry);
			current.add(entry);
		}
		while (current.size > 0) {
			List<Equipment> next = new ArrayList();
			for (Equipment e : current) {
				for (Equipment s : e.successors) {
					if (s != parameters.avoided) {
						if (!seen.contains(s)) {
							seen.add(s);
							next.add(s);
						}
					}
				}
			}
			current = next;
		}
		return seen;
	}

	// Bottleneck = minimal nominal cadence among the critical equipments.
	public Equipment getBottleneck() {
		Equipment bottleneck = null;
		Double minRate = null;
		for (Equipment eq : select Equipment from this) {
			if (eq.isCritical) {
				if (minRate == null) {
					minRate = eq.nominalRate;
					bottleneck = eq;
				} else {
					if (eq.nominalRate < minRate) {
						minRate = eq.nominalRate;
						bottleneck = eq;
					}
				}
			}
		}
      log "Bottleneck: " + bottleneck;
		return bottleneck;
	}

	// =========================================================================
	// Priority hierarchy (spec sections 4-5). CONV03 on top; ETI04A NOT actionable despite
	// the highest raw vibration - topology is what separates the bottleneck from the lure.
	// =========================================================================
	// Is a ranked above b? Rank first, then how close to its own threshold.
	public Boolean hasHigherPriorityThan(Equipment a, Equipment b) {
		if (parameters.a.priorityRank > parameters.b.priorityRank) { return true; }
		if (parameters.a.priorityRank < parameters.b.priorityRank) { return false; }
		return parameters.a.ratioOrZero > parameters.b.ratioOrZero;
	}

	// The maintenance list, most urgent first: each equipment slots in behind everyone already
	// ranked above it. Six machines - the point is to read the rule, not to sort fast.
	public List<Equipment> getPrioritizedEquipments() {
		List<Equipment> ordered = new ArrayList();
		for (Equipment candidate : select Equipment from this) {
			int position = 0;
			for (Equipment ranked : ordered) {
				if (this.hasHigherPriorityThan(ranked,candidate)) {
					position = position + 1;
				}
			}
			ordered.add(position,candidate);
		}
		return ordered;
	}

	public Equipment getTopPriority() {
		Equipment best = null;
		for (Equipment eq : select Equipment from this) {
			if (best == null) {
				best = eq;
			} else {
				if (this.hasHigherPriorityThan(eq,best)) {
					best = eq;
				}
			}
		}
		return best;
	}

	// The equipments maintenance should actually act on. CONV03 only - ETI04A is deliberately out,
	// despite carrying the highest raw vibration of the whole workbook.
	public List<Equipment> getActionablePriorities() {
		List<Equipment> result = new ArrayList();
		for (Equipment eq : this.getPrioritizedEquipments()) {
			if (eq.isActionablePriority) {
				result.add(eq);
			}
		}
		return result;
	}

	// Display helper for the live demo: the priority list as plain codes.
	public List<String> getPrioritizedCodes() {
		List<String> result = new ArrayList();
		for (Equipment eq : this.getPrioritizedEquipments()) {
			result.add(eq.code);
		}
		return result;
	}

	// =========================================================================
	// Live manipulation 3 (applied in memory, then re-synchronized; never saved).
	// Manipulations 1 and 2 are carried by Equipment, the object they concern.
	// =========================================================================

	// Manipulation 3 - add the L7 bypass (EQ-REM-02:OUT -> EQ-ETI-04A:IN), then re-attach.
	public addBypassL7() {
		XMLComplexType linkType = ligneXml.metaModel.getComplexTypeFromURI("http://www.dke.de/CAEX#InternalLinkType");
		XMLIndividual l7 = ligneXml.addNewIndividual(linkType);
		l7.setPropertyValue("Name","L7");
		l7.setPropertyValue("RefPartnerSideA","EQ-REM-02:OUT");
		l7.setPropertyValue("RefPartnerSideB","EQ-ETI-04A:IN");
		this.synchronize();
	}

	/**
	 * A material link of the line, instantiated on an InternalLink of the XML. Its two ends are not
	 * strings: they are roles pointing at the Equipment instances the link names. Interfaces are
	 * shared (EQ-CONV-03:OUT carries both L3 and L4), which is why the graph is navigated through
	 * the links rather than through the interfaces.
	 */
   @Renderer("MaterialLink " + this.source.code + "-" + this.target.code)
 	public concept MaterialLink {

		InternalLink xmlLink with XMLIndividualRole(container=ligneXml, xsdType=INTERNAL_LINK);
		Equipment source with ConceptInstance();
		Equipment target with ConceptInstance();

		create(required InternalLink l) {
			xmlLink = parameters.l;
		}

		delete() {
		}

		String nom values "" + xmlLink.getPropertyValue("Name");
		String sourceInterface values "" + xmlLink.getPropertyValue("RefPartnerSideA");
		String targetInterface values "" + xmlLink.getPropertyValue("RefPartnerSideB");
		// "EQ-CONV-03:OUT" -> "CONV03" : the same join rule as the equipments.
		String sourceCode values this.container.codeFromInterface(this.sourceInterface);
		String targetCode values this.container.codeFromInterface(this.targetInterface);
	}

	/**
	 * The federative concept. Four roles point at the actual artifact elements it joins, and every
	 * business property below is derived from them - none is ever stored.
	 * assetRecord is empty when the equipment is absent from the inventory (planted EQ-ETI-04B).
	 */
    @Renderer("Equipment " + this.code)
    public concept Equipment {

		// --- Roles: what this equipment IS, in each artifact ---
		InternalElement xmlElement with XMLIndividualRole(container=ligneXml, xsdType=INTERNAL_ELEMENT);
		AssetRecord assetRecord with ConceptInstance();
		Reading[0,*] readings with ConceptInstance();
		Intervention[0,*] interventions with ConceptInstance();

		create(required InternalElement e) {
			xmlElement = parameters.e;
		}

		// Stale equipements are removed from the federation; the artifacts are never touched.
		delete() {
		}

		// --- Identity, from the XML side ---
		String xmlId values "" + xmlElement.getPropertyValue("ID");
		String code values this.container.codeFromXmlId(this.xmlId);

		// XML label (topology owner) vs Excel designation (maintenance owner) deliberately differ.
		String xmlLabel values "" + xmlElement.getPropertyValue("Name");

		// In CAEX, properties are generic <Attribute Name="…" Value="…"/> children (spec section 7).
		// This single generic lookup is written once, and promoted below into named properties.
		String attributeValue(String attrName) {
			for (XMLIndividual child : xmlElement.children) {
				String tn = "" + child.type.name;
				if (tn == "AttributeType") {
					String n = "" + child.getPropertyValue("Name");
					if (n == parameters.attrName) {
						return "" + child.getPropertyValue("Value");
					}
				}
			}
			return null;
		}

		// CAEX attributes promoted to named, typed properties: fidelity to AutomationML on one
		// side, readable projection on the other. Connie has no implicit String->number coercion,
		// but a Java static call works in an FML expression.
		String type values this.attributeValue("Type");
		Double nominalRate values Double.parseDouble(this.attributeValue("NominalRate"));
		Double vibrationThreshold values Double.parseDouble(this.attributeValue("VibrationThreshold"));
		Double bearingTemperatureThreshold values Double.parseDouble(this.attributeValue("BearingTemperatureThreshold"));

		// --- Excel projection, through the filled roles ---
		Boolean isInInventory values this.assetRecord != null;
		String assetDesignation {
			String get() {
				if (this.assetRecord == null) { return null; }
				return this.assetRecord.designation;
			}
		};

		// The vibration readings only, in workbook (chronological) order.
		List<Reading> vibrations {
			List<Reading> get() {
				List<Reading> result = new ArrayList();
				for (Reading r : this.readings) {
					if (r.quantity == "Vibration") {
						result.add(r);
					}
				}
				return result;
			}
		};

		Double lastVibration {
			Double get() {
				Double last = null;
				for (Reading r : this.vibrations) {
					last = r.value;
				}
				return last;
			}
		};

		Intervention lastIntervention {
			Intervention get() {
				Intervention last = null;
				for (Intervention i : this.interventions) {
					last = i;
				}
				return last;
			}
		};

		// The temperature readings, same shape as the vibrations: the model privileges no physical
		// quantity, it federates whatever the workbook happens to record.
		List<Reading> bearingTemperatures {
			List<Reading> get() {
				List<Reading> result = new ArrayList();
				for (Reading r : this.readings) {
					if (r.quantity == "Bearing temperature") {
						result.add(r);
					}
				}
				return result;
			}
		};

		Double lastBearingTemperature {
			Double get() {
				Double last = null;
				for (Reading r : this.bearingTemperatures) {
					last = r.value;
				}
				return last;
			}
		};

		// --- Transverse derivations: the XML threshold meets the Excel measurement ---
		Double thresholdRatio {
			Double get() {
				if (this.lastVibration == null) { return null; }
				if (this.vibrationThreshold == null) { return null; }
				return this.lastVibration / this.vibrationThreshold;
			}
		};

		// DEPASSEMENT (>=1) / SURVEILLANCE (>=0.8) / NORMAL, or INCONNU without a reading.
		String thresholdStatus {
			String get() {
				if (this.thresholdRatio == null) { return "UNKNOWN"; }
				if (this.thresholdRatio >= 1.0) { return "EXCEEDED"; }
				if (this.thresholdRatio >= 0.8) { return "WATCH"; }
				return "NORMAL";
			}
		};

		// A second, independent indicator: how hot the bearing runs against its own XML threshold.
		// It CORROBORATES the vibration reading without entering effectiveCriticity - the verdict of
		// the demo stays built on vibration and topology alone. Null when nobody measures it (ETI04A).
		Double temperatureRatio {
			Double get() {
				if (this.lastBearingTemperature == null) { return null; }
				if (this.bearingTemperatureThreshold == null) { return null; }
				return this.lastBearingTemperature / this.bearingTemperatureThreshold;
			}
		};

		// Rising over the last 4 vibration readings.
		Boolean isRising {
			Boolean get() {
				List<Reading> v = this.vibrations;
				if (v.size < 4) { return false; }
				Reading dernier = v.get(v.size - 1);
				Reading reference = v.get(v.size - 4);
				return dernier.value > reference.value;
			}
		};

		// isDrifting = rising vibration trend AND already at 80% of the threshold.
		Boolean isDrifting {
			Boolean get() {
				if (this.thresholdRatio == null) { return false; }
				if (this.thresholdRatio < 0.8) { return false; }
				return this.isRising;
			}
		};

		// --- Topology, read off the MaterialLink graph: never declared, always derived ---
		List<Equipment> successors {
			List<Equipment> get() {
				List<Equipment> result = new ArrayList();
				for (MaterialLink l : this.container.getMaterialLinks()) {
					if (l.source == this) {
						result.add(l.target);
					}
				}
				return result;
			}
		};

		List<Equipment> predecessors {
			List<Equipment> get() {
				List<Equipment> result = new ArrayList();
				for (MaterialLink l : this.container.getMaterialLinks()) {
					if (l.target == this) {
						result.add(l.source);
					}
				}
				return result;
			}
		};

		Boolean isEntry values this.predecessors.size == 0;
		Boolean isExit values this.successors.size == 0;

		// Critical iff removing it makes the exit unreachable from the entry. THE derived property
		// of the demo: nothing in either artifact declares it.
		Boolean isCritical {
			Boolean get() {
				List<Equipment> accessibles = this.container.reachableFromEntryWithout(this);
				return !accessibles.contains(this.container.getExit());
			}
		};

		Boolean isBottleneck values this.container.getBottleneck() == this;

		// effectiveCriticity = isCritical AND isDrifting, aggravated when it is the bottleneck.
		// This is the property no single artifact can produce.
		String effectiveCriticity {
			String get() {
				if (!this.isDrifting) { return "NORMAL"; }
				if (!this.isCritical) { return "TO_WATCH"; }
				if (this.isBottleneck) { return "CRITICAL_BOTTLENECK"; }
				return "CRITICAL";
			}
		};

		// --- Where this equipment sits in the maintenance queue ---
		int priorityRank {
			int get() {
				if (this.effectiveCriticity == "CRITICAL_BOTTLENECK") { return 3; }
				if (this.effectiveCriticity == "CRITICAL") { return 2; }
				if (this.effectiveCriticity == "TO_WATCH") { return 1; }
				return 0;
			}
		};

		// Worth acting on = critical AND drifting. "Watch it" is not an intervention.
		Boolean isActionablePriority values this.priorityRank >= 2;

		Double ratioOrZero {
			Double get() {
				if (this.thresholdRatio == null) { return 0.0; }
				return this.thresholdRatio;
			}
		};

		// --- Live manipulations, carried by the equipment they concern ---

		// Manipulation 2 - append one vibration reading to the workbook, then re-attach the
		// structure so it enters this equipment's "readings" role. Every derived value follows.
		addVibrationReading(double value, String operator) {
			// Bind the cast to a local first: a cast used directly as a method receiver loses the
			// receiver in the binding analyzer.
			XLSVirtualModelInstance xls = (XLSVirtualModelInstance)this.container.maintenance;
			Reading r = (Reading)xls.createReflectedInstance("Reading");
			r.code = this.code;
			r.quantity = "Vibration";
			r.value = parameters.value;
			r.unit = "mm/s";
			r.operator = parameters.operator;
			this.container.synchronize();
		}

		// Manipulation 2 - project the derived criticity into the Assets sheet (column H, left free
		// for this). A projection SINK: the twin writes it out, it never reads it back as a source.
		writeCriticityToAssetRecord() {
			if (this.assetRecord == null) { return; }
			this.assetRecord.criticity = this.effectiveCriticity;
		}
	}
}
