// J6 / Manipulation 1 - the transverse question (specification-demo.md sections 4 and 5).
// "Which equipment should maintenance address first?" The three possible readings disagree,
// and that disagreement is the whole point of federating the two artifacts.

vm = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/FML/Ligne.fml"];
xmlRes = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/ligne.xml"];
xlsxRes = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/exploitation.xlsx"];
service ResourceCenterService add_temp_rc;
ligne = new Ligne(xmlRes.resource, xlsxRes.resource) with (name="ligneL2");

conv = ligne.getEquipementParCode("CONV03");
eti = ligne.getEquipementParCode("ETI04A");

// Reading 1 - the workbook alone, raw vibration: ETI04A is by far the most vibrating -> WRONG.
log "raw vibration ETI04A=" + eti.derniereVibration + " CONV03=" + conv.derniereVibration;
assert eti.derniereVibration > conv.derniereVibration;

// Reading 2 - plus the XML thresholds: both at ~93% -> a tie, no decision possible.
log "tauxSeuil CONV03=" + conv.tauxSeuil + " ETI04A=" + eti.tauxSeuil;
assert conv.tauxSeuil > 0.92;
assert conv.tauxSeuil < 0.94;
assert eti.tauxSeuil > 0.92;
assert eti.tauxSeuil < 0.94;

// Reading 3 - plus the topology: ETI04A is doubled by ETI04B, CONV03 is the bottleneck nothing
// bypasses -> CONV03, unambiguously.
log "ETI04A doublee par " + eti.predecesseurs.get(0).successeurs.size + " branches paralleles";
assert eti.estCritique == false;
assert conv.estCritique == true;
assert conv.estGoulot == true;

log "prioritized=" + ligne.getCodesPrioritaires();
assert ligne.getPrioriteMax().code == "CONV03";
assert ligne.getPrioritesActionnables().size == 1;
assert ligne.getPrioritesActionnables().get(0).code == "CONV03";
assert eti.estPrioriteActionnable == false;

log "Test PASSED: J6 Manip1 - federation resolves the tie: CONV03, not ETI04A";
