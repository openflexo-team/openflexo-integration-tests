// J3 - Topology as instantiated Liaison objects, and what it derives: estCritique, estGoulot.
// Expected business values (specification-demo.md section 4):
//   entry = DEP01, exit = ENC05
//   estCritique TRUE for DEP01, REM02, CONV03, ENC05
//   estCritique FALSE for ETI04A and ETI04B (parallel branch: each bypassable by the other)
//   estGoulot: CONV03 (minimal nominal cadence 950 among the critical equipments)

vm = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/FML/Ligne.fml"];
xmlRes = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/ligne.xml"];
xlsxRes = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/exploitation.xlsx"];
service ResourceCenterService add_temp_rc;
ligne = new Ligne(xmlRes.resource, xlsxRes.resource) with (name="ligneL2");

// --- The graph is made of objects, not of parsed strings ---
assert ligne.getLiaisons().size == 6;

// The ends of a Liaison are Equipement instances, not parsed strings. NB: a 'select' returns the
// instances in no particular order, so navigate the graph rather than index into the list.
dep = ligne.getEquipementByCode("DEP01");
assert dep.successeurs.size == 1;
assert dep.successeurs.get(0).code == "REM02";

conv = ligne.getEquipementByCode("CONV03");
// CONV03 feeds BOTH labellers: this is the fork that makes ETI04A dispensable.
assert conv.successeurs.size == 2;
assert conv.predecesseurs.size == 1;
assert conv.predecesseurs.get(0).code == "REM02";

// Entry and exit are derived, not declared
log "entree=" + ligne.getEntree().code + " sortie=" + ligne.getSortie().code;
assert ligne.getEntree().code == "DEP01";
assert ligne.getSortie().code == "ENC05";
assert ligne.getEntree().estEntree == true;
assert conv.estEntree == false;

// estCritique - derived from the topology, never declared anywhere
assert dep.estCritique == true;
assert ligne.getEquipementByCode("REM02").estCritique == true;
assert conv.estCritique == true;
assert ligne.getEquipementByCode("ETI04A").estCritique == false;
assert ligne.getEquipementByCode("ETI04B").estCritique == false;
assert ligne.getEquipementByCode("ENC05").estCritique == true;

// estGoulot - minimal nominal cadence among the critical equipments = CONV03 (950)
log "cadences DEP01=" + dep.cadenceNominale
	+ " REM02=" + ligne.getEquipementByCode("REM02").cadenceNominale
	+ " CONV03=" + conv.cadenceNominale
	+ " ENC05=" + ligne.getEquipementByCode("ENC05").cadenceNominale;
log "goulot=" + ligne.getGoulot().code;
assert conv.cadenceNominale == 950.0;
assert ligne.getGoulot().code == "CONV03";
assert conv.estGoulot == true;
assert dep.estGoulot == false;
assert ligne.getEquipementByCode("ETI04A").estGoulot == false;

log "Test PASSED: J3 - Liaison graph, estCritique + estGoulot (CONV03 critical bottleneck, 950)";
