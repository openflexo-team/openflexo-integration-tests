// J6 / Manipulation 3 - reconfiguration (specification-demo.md section 5).
// Add a single InternalLink L7 (EQ-REM-02:OUT -> EQ-ETI-04A:IN). This bypass creates a path
// DEP01 -> REM02 -> ETI04A -> ENC05 that avoids CONV03. CONV03 ceases to be critical while its
// vibration stays above threshold: the alert does NOT disappear, it DE-CLASSES
// (from a line-stop risk to an intervention to schedule at the next planned stop).
// Applied in memory; ligne.xml is untouched.

vm = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/FML/Ligne.fml"];
xmlRes = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/ligne.xml"];
xlsxRes = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/exploitation.xlsx"];
service ResourceCenterService add_temp_rc;
ligne = new Ligne(xmlRes.resource, xlsxRes.resource) with (name="ligneL2");

// --- Before: CONV03 is the critical bottleneck ---
log "BEFORE CONV03 critique=" + ligne.estCritique("CONV03") + " criticite=" + ligne.criticiteEffective("CONV03");
assert ligne.estCritique("CONV03") == true;
assert ligne.criticiteEffective("CONV03") == "CRITIQUE_GOULOT";
assert ligne.getTopPriorityCode() == "CONV03";

// --- Manipulation: add the L7 bypass ---
ligne.addBypassL7();

// --- After: CONV03 is no longer critical, but its vibration is still in drift ---
log "AFTER  CONV03 critique=" + ligne.estCritique("CONV03")
	+ " enDerive=" + ligne.enDerive("CONV03")
	+ " criticite=" + ligne.criticiteEffective("CONV03");
assert ligne.estCritique("CONV03") == false;
// the vibration reading has not changed: still above 0.8 of its threshold, still trending up
assert ligne.enDerive("CONV03") == true;
assert ligne.seuilStatus("CONV03") == "SURVEILLANCE";
// the alert de-classes, it does not vanish
assert ligne.criticiteEffective("CONV03") == "A_SURVEILLER";
// CONV03 leaves the actionable priority set
assert ligne.isActionablePriority("CONV03") == false;

log "Test PASSED: J6 Manip3 - CONV03 de-classes CRITIQUE_GOULOT -> A_SURVEILLER (alert re-scoped, not cleared)";
