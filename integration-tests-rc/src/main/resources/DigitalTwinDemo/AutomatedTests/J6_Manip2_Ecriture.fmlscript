// J6 / Manipulation 2 - liveness and write-back (specification-demo.md section 5).
// Add a vibration reading 4.9 mm/s on CONV03: 4.9 > 4.5, so CONV03 goes from "sous surveillance"
// to "dépassement de seuil". Then the twin projects the effective criticity into Parc column H.
// Everything in memory; the artifacts stay untouched.

vm = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/FML/Ligne.fml"];
xmlRes = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/ligne.xml"];
xlsxRes = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/exploitation.xlsx"];
service ResourceCenterService add_temp_rc;
ligne = new Ligne(xmlRes.resource, xlsxRes.resource) with (name="ligneL2");

conv = ligne.getEquipementByCode("CONV03");

// --- Before ---
log "BEFORE tauxSeuil=" + conv.tauxSeuil + " statut=" + conv.statutSeuil + " releves=" + conv.releves.size;
assert conv.derniereVibration == 4.2;
assert conv.releves.size == 14;
assert conv.tauxSeuil < 1.0;
assert conv.statutSeuil == "SURVEILLANCE";

// --- Manipulation: the equipment records one more vibration reading ---
// The row is appended to the workbook and the structure re-attached, so the new reading enters
// this equipment's "releves" role. Nothing else is refreshed by hand.
conv.ajouterReleveVibration(4.9, "MPR");

// --- After: every derived value followed on its own ---
log "AFTER  tauxSeuil=" + conv.tauxSeuil + " statut=" + conv.statutSeuil + " releves=" + conv.releves.size;
assert conv.releves.size == 15;
assert conv.derniereVibration == 4.9;
assert conv.tauxSeuil > 1.0;
assert conv.statutSeuil == "DEPASSEMENT";
// still the critical bottleneck in drift
assert conv.criticiteEffective == "CRITIQUE_GOULOT";

// --- Write-back into Parc!H : a projection SINK, never a source of truth ---
conv.ecrireCriticiteDansFiche();
log "Parc!H CONV03 = " + conv.fiche.criticite;
assert conv.fiche.criticite == "CRITIQUE_GOULOT";

log "Test PASSED: J6 Manip2 - alert rises to DEPASSEMENT, criticity projected into Parc!H";
