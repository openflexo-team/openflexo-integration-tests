// J5 - Prioritized maintenance list (manipulation 1 of the demo).
// Expected business values (specification-demo.md sections 4 and 5):
//   - CONV03 is the single top priority (critical bottleneck in drift).
//   - ETI04A is NOT in the actionable priorities, despite the HIGHEST raw vibration (6.5 > 4.2),
//     because topology makes it non-critical. This is the whole argument of the demo.

vm = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/FML/Ligne.fml"];
xmlRes = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/ligne.xml"];
xlsxRes = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/exploitation.xlsx"];
service ResourceCenterService add_temp_rc;
ligne = new Ligne(xmlRes.resource, xlsxRes.resource) with (name="ligneL2");

conv = ligne.getEquipementByCode("CONV03");
eti = ligne.getEquipementByCode("ETI04A");

log "prioritized = " + ligne.getCodesPrioritaires();
log "actionable  = " + ligne.getPrioritesActionnables().size + " equipement(s)";

// The naive reading (raw vibration) would put ETI04A first...
assert eti.derniereVibration > conv.derniereVibration;

// ...but the federated model puts CONV03 on top.
assert ligne.getPrioriteMax().code == "CONV03";
assert ligne.getCodesPrioritaires().get(0) == "CONV03";

// Actionable priorities = { CONV03 } only. ETI04A is deliberately excluded.
assert ligne.getPrioritesActionnables().size == 1;
assert ligne.getPrioritesActionnables().get(0).code == "CONV03";
assert conv.estPrioriteActionnable == true;
assert conv.rangPriorite == 3;
assert eti.estPrioriteActionnable == false;
assert eti.rangPriorite == 1;

log "Test PASSED: J5 - CONV03 top priority, ETI04A excluded despite higher raw vibration";
