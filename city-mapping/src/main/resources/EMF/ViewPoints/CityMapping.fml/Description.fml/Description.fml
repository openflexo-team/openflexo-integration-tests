use org.openflexo.technologyadapter.diagram.TypedDiagramModelSlot as DIAGRAM;

import org.openflexo.technologyadapter.diagram.model.Diagram;
import org.openflexo.technologyadapter.diagram.metamodel.DiagramSpecification;

import DiagramSpecification DESCRIPTION from ["http://www.thalesgroup.com/openflexo/emf/CityMapping/Description/Description.diagramspecification"];

@Version("0.1")
model Description {
	Diagram typedDiagramModelSlot with TypedDiagram(diagramSpecification=DESCRIPTION,isRequired=true,paletteElementBindings={});
}
