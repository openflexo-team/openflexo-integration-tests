// J5 - Prioritized maintenance list (manipulation 1 of the demo).
// Expected business values (specification-demo.md sections 4 and 5):
//   - CONV03 is the single top priority (critical bottleneck in drift).
//   - ETI04A is NOT in the actionable priorities, despite the HIGHEST raw vibration (6.5 > 4.2),
//     because topology makes it non-critical. This is the whole argument of the demo.

vm = load -r ["http://openflexo.org/digital-twin-demo/FML/ProductionLine.fml"];
xmlRes = load -r ["http://openflexo.org/digital-twin-demo/production-line.xml"];
xlsxRes = load -r ["http://openflexo.org/digital-twin-demo/maintenance.xlsx"];
service ResourceCenterService add_temp_rc;
line = new ProductionLine(xmlRes.resource, xlsxRes.resource) with (name="lineL2");

conv = line.getEquipmentByCode("CONV03");
eti = line.getEquipmentByCode("ETI04A");

log "prioritized = " + line.getPrioritizedCodes();
log "actionable  = " + line.getActionablePriorities().size + " equipement(s)";

// The naive reading (raw vibration) would put ETI04A first...
assert eti.lastVibration > conv.lastVibration;

// ...but the federated model puts CONV03 on top.
assert line.getTopPriority().code == "CONV03";
assert line.getPrioritizedCodes().get(0) == "CONV03";

// Actionable priorities = { CONV03 } only. ETI04A is deliberately excluded.
assert line.getActionablePriorities().size == 1;
assert line.getActionablePriorities().get(0).code == "CONV03";
assert conv.isActionablePriority == true;
assert conv.priorityRank == 3;
assert eti.isActionablePriority == false;
assert eti.priorityRank == 1;

log "Test PASSED: J5 - CONV03 top priority, ETI04A excluded despite higher raw vibration";
