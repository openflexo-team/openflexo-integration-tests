// J4 - Transverse derivations: the XML threshold meets the Excel measurement.
// Expected business values (specification-demo.md sections 3 and 4):
//   tauxSeuil CONV03 = 4.2/4.5 = 0.933 ; ETI04A = 6.5/7.0 = 0.929  -> both ~93% (deliberate tie)
//   tauxSeuil DEP01 = 4.1/6.0 = 0.68 ; REM02 = 0.52 ; ENC05 = 0.60 (< 0.8)
//   enDerive TRUE for CONV03 and ETI04A, FALSE for DEP01/REM02/ENC05
//   criticiteEffective: CONV03 = CRITIQUE_GOULOT ; ETI04A = A_SURVEILLER (drifting, not critical)

vm = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/FML/Ligne.fml"];
xmlRes = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/ligne.xml"];
xlsxRes = load -r ["http://openflexo.org/integration-tests/DigitalTwinDemo/exploitation.xlsx"];
service ResourceCenterService add_temp_rc;
ligne = new Ligne(xmlRes.resource, xlsxRes.resource) with (name="ligneL2");

conv = ligne.getEquipementParCode("CONV03");
eti = ligne.getEquipementParCode("ETI04A");
dep = ligne.getEquipementParCode("DEP01");
rem = ligne.getEquipementParCode("REM02");
enc = ligne.getEquipementParCode("ENC05");

log "derniereVibration CONV03=" + conv.derniereVibration + " ETI04A=" + eti.derniereVibration;
log "tauxSeuil CONV03=" + conv.tauxSeuil + " ETI04A=" + eti.tauxSeuil + " DEP01=" + dep.tauxSeuil;
log "criticiteEffective CONV03=" + conv.criticiteEffective + " ETI04A=" + eti.criticiteEffective;

// The measurement comes from the workbook, the threshold from the XML.
assert conv.derniereVibration == 4.2;
assert conv.seuilVibration == 4.5;
assert eti.derniereVibration == 6.5;
assert eti.seuilVibration == 7.0;

// tauxSeuil: the deliberate ~93% tie (CONV03 0.933, ETI04A 0.929)
assert conv.tauxSeuil > 0.93;
assert conv.tauxSeuil < 0.94;
assert eti.tauxSeuil > 0.92;
assert eti.tauxSeuil < 0.93;
// CONV03 marginally above ETI04A - far too close to decide anything on
assert conv.tauxSeuil > eti.tauxSeuil;

// background equipments, well below the 0.8 alert band
assert dep.tauxSeuil < 0.7;
assert rem.tauxSeuil < 0.6;
assert enc.tauxSeuil < 0.7;

// A SECOND indicator, on another physical quantity, corroborates CONV03 without taking part in
// the verdict: the bearing also runs at 95% of its temperature threshold.
log "temperature CONV03=" + conv.derniereTemperature + "/" + conv.seuilTemperature
	+ " -> " + conv.tauxTemperature;
assert conv.temperatures.size == 7;
assert conv.derniereTemperature == 57.0;
assert conv.seuilTemperature == 60.0;
assert conv.tauxTemperature > 0.94;
assert conv.tauxTemperature < 0.96;
// ETI04A is simply not monitored on temperature: the model tolerates the missing data
assert eti.temperatures.size == 0;
assert eti.derniereTemperature == null;
assert eti.tauxTemperature == null;

// enDerive = rising over the last 4 readings AND already at 80% of the threshold
assert conv.tendanceCroissante == true;
assert conv.enDerive == true;
assert eti.enDerive == true;
assert dep.enDerive == false;
assert rem.enDerive == false;
assert enc.enDerive == false;

// criticiteEffective : topology is what separates the bottleneck from the lure
assert conv.criticiteEffective == "CRITIQUE_GOULOT";
assert eti.criticiteEffective == "A_SURVEILLER";
assert dep.criticiteEffective == "NORMALE";
assert rem.criticiteEffective == "NORMALE";
assert enc.criticiteEffective == "NORMALE";

log "Test PASSED: J4 - ~93% tie, enDerive, criticiteEffective (CONV03 aggravated, ETI04A only watched)";
