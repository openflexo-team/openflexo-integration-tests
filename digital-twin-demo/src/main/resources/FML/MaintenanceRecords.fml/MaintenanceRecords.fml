/**
 * DigitalTwinDemo - VirtualModel "MaintenanceRecords".
 *
 * Business-flavoured typing of the maintenance workbook (maintenance.xlsx), consumed through a
 * FMLExcelModelSlot. Each significative row of a sheet is reflected as a FlexoConceptInstance, and
 * each @Property binds a typed cell (read AND write). This replaces the raw ExcelWorkbook navigation
 * that a BasicExcelModelSlot would expose: ProductionLine now speaks of Reading / AssetRecord / Intervention,
 * not of rows and columns, and an Equipment can hold them in roles.
 *
 * Sheet layouts (see specification-demo.md):
 *   - "Readings": headers on row 1, data from 0-based row 1.
 *     cols 0 Date | 1 Equipment code | 2 Quantity | 3 Value | 4 Unit | 5 Operator
 *   - "Assets": title on rows 1-2, headers on row 4, data from 0-based row 4.
 *     cols 0 Code | 1 Designation | ... | 7 Criticity (write-back column, empty in the source)
 *   - "Interventions": headers on row 1, data from 0-based row 1.
 *     cols 0 Date | 1 Equipment code | 2 Type | 3 Description | 4 Downtime (min)
 */

use org.openflexo.technologyadapter.excel.FMLExcelModelSlot as XLS;

import org.openflexo.technologyadapter.excel.model.ExcelWorkbook;
import java.util.Date;
import java.lang.String;

@URI("http://openflexo.org/digital-twin-demo/FML/MaintenanceRecords.fml")
public model MaintenanceRecords {

	// One reflected instance per timestamped reading in the "Readings" sheet.
	@DataRange(sheet="Readings", rows="1,*", cols="0,5")
	public concept Reading {
		@Property(col="0")
		Date date;
		@Property(col="1")
		String code;
		@Property(col="2")
		String quantity;
		// Primitive 'double', not the wrapper Double: only Java primitives (and String/Date) map to a
		// PrimitiveRole, which is what the reflected cell read/write binds to (a wrapper -> JavaRole -> null).
		@Property(col="3")
		double value;
		@Property(col="4")
		String unit;
		@Property(col="5")
		String operator;
	}

	// One reflected instance per maintenance operation in the "Interventions" sheet.
	@DataRange(sheet="Interventions", rows="1,*", cols="0,4")
	public concept Intervention {
		@Property(col="0")
		Date date;
		@Property(col="1")
		String code;
		// "Preventive" / "Corrective"
		@Property(col="2")
		String type;
		@Property(col="3")
		String description;
		@Property(col="4")
		double downtime;
	}

	// One reflected instance per inventoried equipment in the "Assets" sheet.
	@DataRange(sheet="Assets", rows="4,*", cols="0,7")
	public concept AssetRecord {
		@Property(col="0")
		String code;
		@Property(col="1")
		String designation;
		// Column H, left free in the source: the twin projects the derived effective criticity here.
		@Property(col="7")
		String criticity;
	}
}
