/**
 * DiagramSpecification - the UML package diagram editor itself.
 *
 * Migrated from the deprecated .fml.xml serialization. Notes on the translation:
 *   - the inline ShapeGraphicalRepresentation / ConnectorGraphicalRepresentation each role
 *     carried has no textual FML form; each was copied into the example diagram as a
 *     dedicated element (userID "SYL") and is referenced here through metamodelElement;
 *   - the "import" role is renamed packageImportStatement: "import" is an FML keyword;
 *   - the model slot named typedDiagramModelSlot is renamed diagram (no stored instance
 *     refers to it);
 *   - the concept inspectors are dropped: FlexoConceptInspector is deprecated in 2.99 and
 *     has no textual FML form;
 *   - the uri parameters used the URI widget, which has no textual FML form; they are plain
 *     text fields now.
 *
 * Data property assertions become ontology bindings (package.name = ...); object property
 * assertions become explicit AddObjectPropertyStatement actions naming their objectProperty.
 */

namespace "http://www.openflexo.org/openflexo/ViewPoints/UML/PackageDiagram.owl/DiagramSpecification/DiagramSpecification.diagramspecification" as PACKAGE_DIAGRAM_SPECIFICATION;

use org.openflexo.technologyadapter.owl.OWLModelSlot as OWL;
use org.openflexo.technologyadapter.diagram.TypedDiagramModelSlot as DIAGRAM;

import java.lang.String;

import org.openflexo.technologyadapter.owl.model.OWLOntology;
import org.openflexo.technologyadapter.owl.model.OWLClass;
import org.openflexo.technologyadapter.owl.model.OWLIndividual;
import org.openflexo.technologyadapter.owl.model.ObjectPropertyStatement;
import org.openflexo.technologyadapter.owl.model.OWLObjectProperty;
import org.openflexo.technologyadapter.diagram.model.Diagram;
import org.openflexo.technologyadapter.diagram.model.DiagramShape;
import org.openflexo.technologyadapter.diagram.model.DiagramConnector;
import org.openflexo.technologyadapter.diagram.metamodel.DiagramSpecification;

import OWLOntology UML2 from ["http://www.openflexo.org/openflexo/ontologies/UML/UML2.owl"];
import OWLClass PACKAGE from [UML2:"Package"];
import OWLClass PACKAGE_IMPORT from [UML2:"PackageImport"];
import OWLObjectProperty PACKAGE_IMPORT_PROP from [UML2:"packageImport"];
import OWLObjectProperty IMPORTED_PACKAGE_PROP from [UML2:"importedPackage"];

import DiagramSpecification PACKAGE_DIAGRAM_SPEC from [PACKAGE_DIAGRAM_SPECIFICATION];
import Diagram EXAMPLE_DIAGRAM from [PACKAGE_DIAGRAM_SPECIFICATION + "/PackageDiagram.diagram"];
import DiagramShape PACKAGE_SHAPE from [EXAMPLE_DIAGRAM:"SYL-1001"];
import DiagramConnector IMPORT_CONNECTOR from [EXAMPLE_DIAGRAM:"SYL-1002"];

@URI("http://www.openflexo.org/openflexo/ViewPoints/UML/PackageDiagram.owl/DiagramSpecification.fml")
@Version("0.1")
public model DiagramSpecification {

	OWLOntology owl with OWLModelSlot(importedOntology=UML2);

	Diagram diagram with TypedDiagram(
		diagramSpecification=PACKAGE_DIAGRAM_SPEC,
		paletteElementBindings={
			PaletteElementBinding:(call=new Package::drop(), paletteElementId="http://www.openflexo.org/openflexo/ViewPoints/UML/PackageDiagram.owl/DiagramSpecification/DiagramSpecification.diagramspecification/DefaultPalette.palette#Package")
		},
		isRequired=true);

	public concept Package {

		OWLIndividual package with OWLIndividualRole(type=PACKAGE);
		DiagramShape shape with ShapeRole(exampleLabel="label", metamodelElement=PACKAGE_SHAPE, label=package.name);

		@UI(
			@TextField(value="name", label="name")
			@TextField(value="uri", label="uri")
		)
		Package drop(String name="Package", required String uri) with DropScheme() {
			package = OWL::AddOWLIndividual(ontologyClass=PACKAGE, individualName=parameters.uri) in owl;
			package.name = parameters.name;
			shape = DIAGRAM::AddShape(container=topLevel);
		}
	}

	public concept ImportPackage {

		OWLIndividual package with OWLIndividualRole(type=PACKAGE);
		OWLIndividual importedPackage with OWLIndividualRole(type=PACKAGE);
		OWLIndividual packageImport with OWLIndividualRole(type=PACKAGE_IMPORT);
		ObjectPropertyStatement packageImportStatement with ObjectPropertyStatementRole(objectProperty=PACKAGE_IMPORT_PROP);
		DiagramConnector connector with ConnectorRole(exampleLabel="label", metamodelElement=IMPORT_CONNECTOR, label="import");

		@UI(
			@TextField(value="uri", label="uri")
		)
		ImportPackage createImport(required String uri) with LinkScheme(fromType=Package, toType=Package) {
			// the legacy assigned the Package *concept instances* to these OWL individual roles
			// ("package = fromTarget"), which 2.99 rejects as a type error; the individual each
			// dropped Package carries is what was meant.
			package = fromTarget.package;
			importedPackage = toTarget.package;
			packageImport = OWL::AddOWLIndividual(ontologyClass=PACKAGE_IMPORT, individualName=parameters.uri) in owl;
			OWL::AddObjectPropertyStatement(subject=packageImport, object=importedPackage, objectProperty=IMPORTED_PACKAGE_PROP) in owl;
			packageImportStatement = OWL::AddObjectPropertyStatement(subject=package, object=packageImport) in owl;
			connector = DIAGRAM::AddConnector(fromShape=fromTarget.shape, toShape=toTarget.shape);
		}
	}
}
