// J6 / Manipulation 1 - the transverse question (specification-demo.md sections 4 and 5).
// "Which equipment should maintenance address first?" The three possible readings disagree,
// and that disagreement is the whole point of federating the two artifacts.

vm = load -r ["http://openflexo.org/digital-twin-demo/FML/ProductionLine.fml"];
xmlRes = load -r ["http://openflexo.org/digital-twin-demo/production-line.xml"];
xlsxRes = load -r ["http://openflexo.org/digital-twin-demo/maintenance.xlsx"];
service ResourceCenterService add_temp_rc;
line = new ProductionLine(xmlRes.resource, xlsxRes.resource) with (name="lineL2");

conv = line.getEquipmentByCode("CONV03");
eti = line.getEquipmentByCode("ETI04A");

// Reading 1 - the workbook alone, raw vibration: ETI04A is by far the most vibrating -> WRONG.
log "raw vibration ETI04A=" + eti.lastVibration + " CONV03=" + conv.lastVibration;
assert eti.lastVibration > conv.lastVibration;

// Reading 2 - plus the XML thresholds: both at ~93% -> a tie, no decision possible.
log "thresholdRatio CONV03=" + conv.thresholdRatio + " ETI04A=" + eti.thresholdRatio;
assert conv.thresholdRatio > 0.92;
assert conv.thresholdRatio < 0.94;
assert eti.thresholdRatio > 0.92;
assert eti.thresholdRatio < 0.94;

// Reading 3 - plus the topology: ETI04A is doubled by ETI04B, CONV03 is the bottleneck nothing
// bypasses -> CONV03, unambiguously.
log "ETI04A doublee par " + eti.predecessors.get(0).successors.size + " branches paralleles";
assert eti.isCritical == false;
assert conv.isCritical == true;
assert conv.isBottleneck == true;

log "prioritized=" + line.getPrioritizedCodes();
assert line.getTopPriority().code == "CONV03";
assert line.getActionablePriorities().size == 1;
assert line.getActionablePriorities().get(0).code == "CONV03";
assert eti.isActionablePriority == false;

log "Test PASSED: J6 Manip1 - federation resolves the tie: CONV03, not ETI04A";
