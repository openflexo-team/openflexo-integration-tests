// J2 - The federative concept Equipment: FOUR ROLES pointing at the actual artifact elements.
// Expected business values (specification-demo.md sections 2 and 4):
//   - 6 InternalElement -> 6 Equipment instances
//   - 5 of them matched to an Assets row; EQ-ETI-04B absent from inventory (planted, not repaired)
//   - labels differ across sides (XML "TransferConveyor" vs Excel designation): joining on a
//     label would be impossible, which is why the join is on the code.

vm = load -r ["http://openflexo.org/digital-twin-demo/FML/ProductionLine.fml"];
assert vm != null;
xmlRes = load -r ["http://openflexo.org/digital-twin-demo/production-line.xml"];
xlsxRes = load -r ["http://openflexo.org/digital-twin-demo/maintenance.xlsx"];
service ResourceCenterService add_temp_rc;
line = new ProductionLine(xmlRes.resource, xlsxRes.resource) with (name="lineL2");
assert line != null;

// One Equipment per InternalElement of the topology
assert line.getEquipments().size == 6;

conv = line.getEquipmentByCode("CONV03");
assert conv != null;

// The join rule EQ-CONV-03 <-> CONV03, declared once and reviewable
assert line.codeFromXmlId("EQ-CONV-03") == "CONV03";
assert conv.xmlId == "EQ-CONV-03";
assert conv.code == "CONV03";

// --- Role 1: the InternalElement of the XML ---
assert conv.xmlElement != null;
assert conv.xmlLabel == "TransferConveyor";
// CAEX generic <Attribute Name Value/> promoted to named, typed properties
assert conv.type == "Conveyor";
assert conv.nominalRate == 950.0;
assert conv.vibrationThreshold == 4.5;

// --- Role 2: its row in the "Assets" sheet (cardinality 1) ---
assert conv.isInInventory == true;
assert conv.assetRecord != null;
assert conv.assetRecord.code == "CONV03";
// The two artifacts name the same machine differently: joining on the label is impossible.
assert conv.assetDesignation == "Labeller transfer conveyor";
log "CONV03 xml='" + conv.xmlLabel + "' assets='" + conv.assetDesignation + "'";

// --- Role 3: its readings in the "Readings" sheet (multiple cardinality) ---
log "CONV03 readings = " + conv.readings.size + " dont vibrations = " + conv.vibrations.size;
assert conv.readings.size == 14;
assert conv.vibrations.size == 7;
assert conv.readings.get(0).code == "CONV03";
assert conv.readings.get(0).quantity == "Vibration";
assert conv.readings.get(0).value > 0.0;

// --- Role 4: its maintenance maintenance in the "Interventions" sheet ---
assert conv.interventions.size == 1;
assert conv.lastIntervention.type == "Preventive";
// the discreet corroboration: ETI04A was serviced twice, CONV03 only once
assert line.getEquipmentByCode("ETI04A").interventions.size == 2;

// --- The planted inconsistency, not repaired: in the XML, absent from the Assets sheet ---
eti04b = line.getEquipmentByCode("ETI04B");
assert eti04b != null;
assert eti04b.isInInventory == false;
assert eti04b.assetRecord == null;
assert eti04b.assetDesignation == null;
assert eti04b.readings.size == 0;
log "ETI04B inventorie = " + eti04b.isInInventory;

log "Test PASSED: J2 - four roles filled, 5 matched, ETI04B unmatched as planted";
